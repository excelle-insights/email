{
    "name": "excelle-insights/email",
    "description": "Multi-provider email package for Excelle applications",
    "type": "library",
    "license": "MIT",
    "keywords": ["email", "phpmailer", "mailgun", "mandrill", "mailchimp", "excelle"],
    "authors": [
        {
            "name": "Excelle Insights",
            "email": "dev@excelleinsights.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "phpmailer/phpmailer": "^6.9",
        "psr/log": "^3.0",
        "robmorgan/phinx": "^0.16",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.22",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "ExcelleInsights\\Email\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ExcelleInsights\\Email\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "style": "php-cs-fixer fix --dry-run --diff",
        "style-fix": "php-cs-fixer fix",
        "lint": "phpcs --standard=PSR12 src tests"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
